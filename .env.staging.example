# Copy to .env.staging and fill values for staging server
DJANGO_SECRET_KEY=replace-me
DEBUG=0
ALLOWED_HOSTS=your-staging.example.com

# Postgres
POSTGRES_DB=zayidni_db
POSTGRES_USER=zayidni
POSTGRES_PASSWORD=securepassword
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# Email (optional)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=secret

# Payment sandbox placeholders
PAYMENT_ZAIN_SANDBOX_KEY=
PAYMENT_QICARD_SANDBOX_KEY=
PAYMENT_ASIAHAWALA_SANDBOX_KEY=
